{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package describe:*)",
      "Bash(swift package dump-package:*)",
      "Bash(swift format lint:*)",
      "Bash(swift --version)",
      "Bash(make:*)",
      "Bash(./Scripts/build_app.sh:*)",
      "Bash(./Scripts/test.sh:*)",
      "Bash(./Scripts/lint.sh:*)",
      "Bash(./Scripts/check_secrets.sh:*)",
      "Bash(Scripts/build_app.sh:*)",
      "Bash(Scripts/test.sh:*)",
      "Bash(Scripts/lint.sh:*)",
      "Bash(Scripts/check_secrets.sh:*)",
      "Bash(bash -n:*)",
      "Bash(xcrun --show-sdk-version)",
      "Bash(xcrun --show-sdk-path)",
      "Bash(sw_vers)",
      "Bash(plutil -lint:*)",
      "Bash(codesign -d:*)",
      "Bash(codesign --verify:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git describe:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(pwd)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:swiftpackageindex.com)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/secrets*.json)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh release:*)",
      "Bash(rm -rf /*)"
    ]
  }
}
